# Editorial light theme — structural containers, typography, and flow connectors.

classes: {
  # ── Containers & Structure ──
  editorial-container: {
    style.fill: "#ECECEC"
    style.stroke: "#D2D6DC"
    style.stroke-width: 1
    style.border-radius: 12
    style.font-color: "#2D3142"
  }
  editorial-panel: {
    style.fill: "#FFFFFF"
    style.stroke: "#BFC0C0"
    style.stroke-width: 1
    style.border-radius: 12
    style.font-color: "#2D3142"
  }
  editorial-swimlane: {
    style.fill: "#F5F5F5"
    style.stroke: "#D2D6DC"
    style.stroke-width: 1
    style.border-radius: 8
    style.font-color: "#4F5D75"
  }
  editorial-boundary: {
    style.fill: "transparent"
    style.stroke: "#7A8399"
    style.stroke-width: 1
    style.stroke-dash: 4
    style.border-radius: 12
    style.font-color: "#4F5D75"
  }
  editorial-card: {
    style.fill: "#FFFFFF"
    style.stroke: "#D2D6DC"
    style.stroke-width: 1
    style.border-radius: 10
    style.font-color: "#2D3142"
  }

  # ── Typography & Labels ──
  editorial-title: {
    shape: text
    style.font-size: 22
    style.font-color: "#2D3142"
    style.bold: true
  }
  editorial-subtitle: {
    shape: text
    style.font-size: 14
    style.font-color: "#4F5D75"
  }
  editorial-label: {
    shape: text
    style.font-size: 13
    style.font-color: "#2D3142"
    style.bold: true
  }
  editorial-section-label: {
    shape: text
    style.font-size: 12
    style.font-color: "#4F5D75"
    style.bold: true
  }
  editorial-eyebrow: {
    shape: text
    style.font-size: 10
    style.font-color: "#7A8399"
    style.bold: true
  }
  editorial-callout: {
    shape: text
    style.font-size: 13
    style.font-color: "#4F5D75"
    style.italic: true
  }
  editorial-note: {
    shape: text
    style.font-size: 11
    style.font-color: "#7A8399"
    style.italic: true
  }
  editorial-sublabel: {
    shape: text
    style.font-size: 11
    style.font-color: "#7A8399"
  }

  # ── Flow Connectors ──
  editorial-flow: {
    style.stroke: "#4F5D75"
    style.stroke-width: 2
    style.font-color: "#4F5D75"
    style.font-size: 11
  }
  editorial-flow-primary: {
    style.stroke: "#EB6C36"
    style.stroke-width: 2
    style.font-color: "#EB6C36"
    style.font-size: 11
    style.bold: true
  }
  editorial-flow-accent: {
    style.stroke: "#EB6C36"
    style.stroke-width: 2
    style.font-color: "#EB6C36"
    style.font-size: 11
    style.bold: true
  }
  editorial-flow-muted: {
    style.stroke: "#BFC0C0"
    style.stroke-width: 1
    style.font-color: "#7A8399"
    style.font-size: 11
  }
  editorial-flow-dashed: {
    style.stroke: "#4F5D75"
    style.stroke-width: 2
    style.stroke-dash: 4
    style.font-color: "#4F5D75"
    style.font-size: 11
  }
  editorial-flow-link: {
    style.stroke: "#2E5AA8"
    style.stroke-width: 2
    style.font-color: "#2E5AA8"
    style.font-size: 11
  }
  editorial-flow-success: {
    style.stroke: "#3D8B57"
    style.stroke-width: 2
    style.font-color: "#2A663E"
    style.font-size: 11
  }
  editorial-flow-danger: {
    style.stroke: "#D14343"
    style.stroke-width: 2
    style.font-color: "#9E2525"
    style.font-size: 11
  }
}
